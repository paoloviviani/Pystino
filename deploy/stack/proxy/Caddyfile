# The deployment's one reverse proxy. Three TLS modes, one file, chosen by the
# environment (pystino init writes all three variables):
#
#   acme       SITE_ADDRESS=https://llm.example.org   TLS_DIRECTIVE=
#   internal   SITE_ADDRESS=https://10.0.0.5          TLS_DIRECTIVE="tls internal"   (dev only)
#   upstream   SITE_ADDRESS=http://:80                TLS_DIRECTIVE=                 (TLS ends in front, e.g. NetBird)
#
# The routes are identical in every mode. A route whose upstream is not running
# (/authelia with the profile off) answers 502; Caddy resolves upstreams per
# request, so a missing service never stops the proxy starting.
#
# No server ever calls the public origin: the gateway and the chat reach the
# IdP on the compose network (internal_base_url), so Caddy's internal CA is
# never something a container has to trust.
{
	email {$ACME_EMAIL:admin@example.org}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

(to_app) {
	# The public origin is https in all three modes; in upstream mode the hop
	# into Caddy is plain HTTP, so the scheme is stated rather than inferred.
	header_up X-Forwarded-Proto https
	flush_interval -1
}

{$SITE_ADDRESS} {
	{$TLS_DIRECTIVE}

	# Component hook: add-ons (the agent machine's dial-in, for one) drop
	# *.caddy snippets into the mounted proxy.d directory.
	import /etc/caddy/extra/*.caddy

	handle /chat/* {
		reverse_proxy chat:3000 {
			import to_app
		}
	}
	redir /chat /chat/

	handle /authelia/* {
		reverse_proxy authelia:9091 {
			import to_app
		}
	}
	redir /authelia /authelia/

	# What everything else — `/` included — goes to: the gateway (API and
	# console), or, on a Cerea-only install with no gateway, a redirect to
	# the chat. PROXY_DEFAULT is gateway | chat; `pystino init` writes it.
	import /etc/caddy/modes/{$PROXY_DEFAULT:gateway}.caddy
}
