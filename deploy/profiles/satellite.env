# Profile: satellite.
#
# Cerea against a central Pystino. This box holds the chat, its MongoDB, its
# Postgres (knowledge vectors) and the proxy — no gateway, no Valkey, no
# redaction, no ledger of its own. Users sign in against the central
# provider, every inference call carries the signed-in person's own access
# token (`USE_USER_TOKEN=true`), and the Usage tab reads the central ledger
# with that same token.
#
# An env fragment, not a whole deployment: copy it to deploy/.env and fill
# every empty value (the generation command is beside each one), or let the
# installer do both. The overlay set this profile needs is derived by the
# Cerea installer's standalone derivation (base + chat + edge|proxy, started
# by service name so the gateway, Valkey and migrations never start) until
# deploy/profiles/overlays.sh gains the matching profile_overlays entries.
#
# Target footprint: estimate only, not yet weighed on a live host —
# roughly the homelab shape minus the gateway and Valkey (~400 MB RSS,
# ~2.5 GB disk, 1 vCPU).

# --- database ---------------------------------------------------------------
# The chat's own Postgres (knowledge passages and vectors). A separate
# database on this box's instance — there is no gateway database here.
POSTGRES_USER=chat
# Generate locally; the installer does. Empty refuses the first start, which
# is the point: a forgotten password must fail, not default.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=chat

# --- central Pystino --------------------------------------------------------
# The central deployment's public origin. The installer derives both the
# inference endpoint (ORIGIN + /v1) and the default OIDC issuer from it.
# No OPENAI_API_KEY here on purpose: the model catalogue fetch reads the
# central gateway's public GET /v1/models (ADR 0081), and every real call
# after that carries the signed-in person's own token.
OPENAI_BASE_URL=
# Always true on this profile: the central gateway bills the caller's own
# token, and a shared key would bill every satellite user to one account.
USE_USER_TOKEN=true

# --- chat -------------------------------------------------------------------
# Absolute path to the Cerea checkout — required, never defaulted. A relative
# default resolves against the compose file's directory, which is right for a
# plain checkout and wrong from a git worktree.
CHAT_REPO=
# e.g. CHAT_PG_URL=postgresql://chat:<password>@postgres:5432/chat (role and
# database created by the installer, or by hand — see homelab.env).
CHAT_PG_URL=
# The chat is its own OIDC client at the central provider: register
# <PUBLIC_ORIGIN>/chat/login/callback there exactly, and point the chat at
# it. All three are mandatory — without them nobody can sign in, and an
# anonymous chat against a central gateway answers nothing.
CHAT_OIDC_PROVIDER_URL=
CHAT_OIDC_CLIENT_ID=
CHAT_OIDC_CLIENT_SECRET=
# CHAT_OIDC_SCOPES=openid profile email
# Encrypts the chat's MCP connector credentials at rest (ADR 0064). Required
# rather than defaulted: a shared default is no encryption that looks like
# encryption.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_SECRET_KEY=
# A plain HTTPS fetch: no renderer service in this profile, and a page built
# by JavaScript arrives as an empty shell — accepted here, because the
# alternative is a 3.45 GB image for an optional fetch backend.
FETCH_BACKEND=direct
# Free: it runs in the signed-in person's own browser sandbox (Pyodide),
# never on this box.
CHAT_CODE_TOOL_ENABLED=true
# On here: the ledger lives on central, and the tab reads it with the
# signed-in person's own token.
CHAT_USAGE_ENABLED=true
# The knowledge pipeline costs nothing extra here — its Postgres is the
# database above, not a second container — so it stays on. Embeddings and
# document extraction run through the central /v1.
CHAT_KNOWLEDGE_ENABLED=true
# Empty on purpose: this origin does not serve the Pystino console —
# satellite's Pystino is central's and its console lives at
# central's origin, not this one. The chat's admin panel shows no console link.
CHAT_CONSOLE_ENABLED=

# --- exposure ---------------------------------------------------------------
# Edge or proxy — one of them is required, not optional: the chat publishes
# no port, so without an exposure overlay it is unreachable (and compose
# refuses the set, because the chat depends on the proxy). The installer asks
# which and writes these. PUBLIC_HOST is what a browser *types*.
PUBLIC_HOST=
HTTPS_PORT=443
# PUBLIC_ORIGIN=
TLS_DIRECTIVE="tls internal"
ACME_EMAIL=
# PUBLIC_BIND=0.0.0.0
