# Profile: homelab.
#
# A self-hosted single-box shape: the gateway, the chat, and nothing else. No
# redaction service, no extractor, no headless browser, no fake upstream. No
# ledger either (ADR 0065) — routing, keys, model access and local sign-in,
# with nothing recorded about what anything cost.
#
# An env fragment, not a whole deployment: copy it to deploy/.env and fill
# every empty value (the generation command is beside each one), or let the
# installer do both. The overlay set this profile needs is not listed here —
# it is derived from deploy/profiles/overlays.sh, the single source both the
# installers and docs/deployment.md read.
#
# Target footprint: ~700 MB RSS, ~3.8 GB disk, 2 vCPU.

# --- database ---------------------------------------------------------------
POSTGRES_USER=gateway
# Generate locally; the installer does. Empty refuses the first start, which
# is the point: a forgotten password must fail, not default.
POSTGRES_PASSWORD=
POSTGRES_DB=gateway

# --- gateway ----------------------------------------------------------------
GATEWAY_ENVIRONMENT=production
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_JSON=true

# Encrypts provider API keys at rest (ADR 0027). Comma-separated to rotate:
# the first value encrypts, any of them decrypts. Back this up with the
# database — losing every value means re-entering each provider's credential
# by hand.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SECRET_KEY=

# Signs management session cookies. Generate the same way:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SESSION_SECRET=

# Behind the edge or proxy overlay this must be true (both overlays set it
# themselves); on the loopback default it stays false, or the cookie is set
# and never sent back and every login lands on a signed-out console.
GATEWAY_SESSION_COOKIE_SECURE=false

GATEWAY_BILLING_CURRENCY=EUR

# --- upstream provider ------------------------------------------------------
# Any OpenAI-compatible endpoint. Without the smoke overlay there is no fake
# to fall back on, so this must name a real one before the first request.
GATEWAY_UPSTREAM__BASE_URL=https://api.cortecs.ai/v1
GATEWAY_UPSTREAM__API_KEY=

# --- no ledger, no quotas, no redaction (ADR 0065) ---------------------------
# Off means *no row*, never a row of zeros — with accounting off the gateway
# writes no usage_records at all. And quotas without a ledger are refused at
# startup (counters rebuild from usage_records, so every ceiling would
# silently pass): the two travel together or not at all.
GATEWAY_ACCOUNTING__ENABLED=false
GATEWAY_QUOTA__ENABLED=false
GATEWAY_REDACTION__ENGINE=noop

# --- sign-in: local passwords and the house IdP ------------------------------
# The console's password form (ADR 0043) plus the gateway as its own identity
# provider for the chat (ADR 0068). Passwords are never set here — create the
# account out-of-band (`docker compose ... exec gateway gateway passwd
# admin@local`); it prompts, so nothing lands in shell history.
GATEWAY_LOCAL_AUTH__ENABLED=true
GATEWAY_IDP__ENABLED=true
# The public origin the IdP issues for — the address browsers use, which the
# installer writes from PUBLIC_ORIGIN below. Empty refuses IdP startup, which
# is what should happen before the origin is known.
GATEWAY_IDP__ISSUER=
# ES256 signing key for id_tokens. Generate locally:
#   openssl ecparam -genkey -name prime256v1
GATEWAY_IDP__SIGNING_KEY=
# Guards the legacy minting endpoints inside the compose network. Generate
# locally; it never leaves the deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_IDP__INTERNAL_TOKEN=
GATEWAY_IDP__INTERNAL_BASE_URL=http://gateway:8000
# The chat's client. The secret must match CHAT_IDP_CLIENT_SECRET below; the
# installer mints one value and writes it in both places.
GATEWAY_IDP__CLIENTS=[{"client_id":"cerea","redirect_path":"/chat/login/callback","secret":""}]

# --- chat -------------------------------------------------------------------
# Absolute path to the Cerea checkout — required, never defaulted. A relative
# default resolves against the compose file's directory, which is right for a
# plain checkout and wrong from a git worktree.
CHAT_REPO=
# A gwk_ key whose user sees every model the deployment offers. The chat
# builds its catalogue once at boot with this key, before anyone has signed
# in; listing bills nothing, so the key spends nothing. Mint it after the
# first boot (console or API), write it here, restart the chat.
CHAT_CATALOGUE_KEY=
# The chat's own database on the gateway's instance — a second database, not
# a second container. The installer creates the role and database; by hand:
#   docker compose ... exec postgres psql -U gateway -c "CREATE ROLE chat WITH LOGIN PASSWORD '...'"
#   docker compose ... exec postgres psql -U gateway -c "CREATE DATABASE chat OWNER chat"
# e.g. CHAT_PG_URL=postgresql://chat:<password>@postgres:5432/chat
CHAT_PG_URL=
# Must match the secret in GATEWAY_IDP__CLIENTS above. Generate locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_IDP_CLIENT_SECRET=
# Encrypts the chat's MCP connector credentials at rest (ADR 0064). Required
# rather than defaulted: a shared default is no encryption that looks like
# encryption.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_SECRET_KEY=
# A plain HTTPS fetch: no renderer service in this profile, and a page built
# by JavaScript arrives as an empty shell — accepted here, because the
# alternative is a 3.45 GB image for an optional fetch backend.
FETCH_BACKEND=direct
# Free: it runs in the signed-in person's own browser sandbox (Pyodide),
# never on this box.
CHAT_CODE_TOOL_ENABLED=true
# Empty on purpose: with no ledger there is nothing for the Usage tab to
# read, so the tab stays hidden.
CHAT_USAGE_ENABLED=
# The knowledge pipeline costs nothing extra here — its Postgres is the second
# database above, not a second container — so it stays on.
CHAT_KNOWLEDGE_ENABLED=true
# On: this origin serves the Pystino console at /console, and the chat's
# admin panel links to it for the platform side (providers, models, prices,
# quotas, users).
CHAT_CONSOLE_ENABLED=true

# --- exposure ---------------------------------------------------------------
# Edge or proxy — one of them is required, not optional: the chat publishes
# no port, so without an exposure overlay it is unreachable (and compose
# refuses the set, because the chat depends on the proxy). The installer asks
# which and writes these. PUBLIC_HOST is what a browser *types*; PUBLIC_BIND
# (proxy only, every interface by default) is what Docker *binds* — on a
# NAT-ed host those are different addresses, which is why they are separate
# variables.
PUBLIC_HOST=
HTTPS_PORT=443
# PUBLIC_ORIGIN=
TLS_DIRECTIVE="tls internal"
ACME_EMAIL=
# PUBLIC_BIND=0.0.0.0
