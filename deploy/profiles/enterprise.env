# Profile: enterprise.
#
# Everything: NER redaction (+750 MB), the headless-browser fetch backend, an
# external OIDC provider instead of the house IdP, and the ledger with its
# quotas so spend can be answered per group. Serve it behind TLS (the proxy
# overlay, or the edge shape) — a deployment of this size on loopback serves
# nobody.
#
# An env fragment: copy it to deploy/.env and fill every empty value (the
# generation command is beside each one), or let the installer do both. The
# overlay set — which spans both repositories, because the Playwright overlay
# lives with its consumer in Cerea — is derived from
# deploy/profiles/overlays.sh, the single source both the installers and
# docs/deployment.md read.

# --- database ---------------------------------------------------------------
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway

# --- gateway ----------------------------------------------------------------
GATEWAY_ENVIRONMENT=production
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_JSON=true

# Encrypts provider API keys at rest (ADR 0027). Comma-separated to rotate.
# Back this up with the database.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SECRET_KEY=

# Signs management session cookies:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SESSION_SECRET=

# True here unconditionally: this profile is served behind TLS, and on plain
# http a Secure cookie is set and never sent back — a login that appears to
# succeed and lands on a signed-out console, with nothing in any log.
GATEWAY_SESSION_COOKIE_SECURE=true

GATEWAY_BILLING_CURRENCY=EUR

# --- upstream provider ------------------------------------------------------
GATEWAY_UPSTREAM__BASE_URL=https://api.cortecs.ai/v1
GATEWAY_UPSTREAM__API_KEY=

# --- ledger on, quotas on, redaction with NER ---------------------------------
GATEWAY_ACCOUNTING__ENABLED=true
GATEWAY_QUOTA__ENABLED=true
GATEWAY_REDACTION__ENGINE=http

# Overlay inputs, not gateway settings (see team.env for the distinction).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDACTION_PLACEHOLDER_KEY=
REDACTION_LANGUAGE=en
# The NER build: the model loads at startup (~900 MB) and PERSON, LOCATION,
# NRP and ORGANIZATION become detectable. By accepting a spaCy model you
# accept its licence — CC BY-NC-SA 3.0 for the Italian name model, where the
# default MIT-only build detects Italian identifiers but not Italian names.
SPACY_MODELS=en_core_web_lg
REDACTION_NLP_ENGINE=spacy

GATEWAY_EXTRACTOR__ENDPOINT=http://extractor:8080

# --- sign-in: external OIDC, local passwords beside it -----------------------
# The house IdP is off: this deployment authenticates against the directory
# it already has (docs/oidc-generic-provider.md has the per-provider
# checklist). Local email + password stays on as the bootstrap door — the
# first administrator is created out-of-band before any directory mapping
# exists (`docker compose ... exec gateway gateway passwd admin@local`).
GATEWAY_OIDC__ENABLED=true
GATEWAY_OIDC__ISSUER=
GATEWAY_OIDC__CLIENT_ID=
GATEWAY_OIDC__CLIENT_SECRET=
# The group claim differs per provider (GitLab groups_direct, Entra ID
# groups, Keycloak realm_access.roles); the redirect is the gateway's
# callback on the public origin, registered exactly.
GATEWAY_OIDC__GROUPS_CLAIM=groups
# GATEWAY_OIDC__REDIRECT_URI=
# Naming an audience is what accepts the provider's access tokens on /v1 —
# which is how the chat calls the gateway when USE_USER_TOKEN=true below, so
# this must match an audience mapper configured on the chat's client at the
# provider. Empty means API keys only.
GATEWAY_OIDC__ACCESS_TOKEN_AUDIENCE=
GATEWAY_LOCAL_AUTH__ENABLED=true
GATEWAY_IDP__ENABLED=false

# Per-group billing is not an environment decision: groups, grants, quota
# rules and prices are console records once the stack is up, and x-bill-to
# lets an OIDC caller choose which of their groups pays per request.

# --- chat -------------------------------------------------------------------
CHAT_REPO=
CHAT_CATALOGUE_KEY=
# e.g. CHAT_PG_URL=postgresql://chat:<password>@postgres:5432/chat (role and
# database created by the installer, or by hand — see homelab.env).
CHAT_PG_URL=
# The chat is its own OIDC client at the external provider now, not on the
# house IdP: register <PUBLIC_ORIGIN>/chat/login/callback there exactly, and
# point the chat at it. Unset, the chat signs in against the house IdP as in
# the other profiles (which is why CHAT_IDP_CLIENT_SECRET below still exists
# as the fallback the overlay requires).
CHAT_OIDC_PROVIDER_URL=
CHAT_OIDC_CLIENT_ID=
CHAT_OIDC_CLIENT_SECRET=
# CHAT_OIDC_SCOPES=openid profile email
# The house-IdP fallback the overlay requires when the three overrides above
# are unset. Generate locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_IDP_CLIENT_SECRET=
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_SECRET_KEY=
# The headless browser in Cerea's playwright overlay: rendered pages, not
# empty JavaScript shells. Opt-in and port-less by design — it is
# unauthenticated remote code execution, and publishing it would make that
# assumption false.
FETCH_BACKEND=playwright
# PLAYWRIGHT_WS_ENDPOINT=ws://playwright:3000/
CHAT_CODE_TOOL_ENABLED=true
CHAT_USAGE_ENABLED=true
CHAT_KNOWLEDGE_ENABLED=true

# --- exposure ---------------------------------------------------------------
# This profile assumes TLS in front: a name with Let's Encrypt, or an address
# with the edge shape. The chat publishes no port, so an exposure overlay is
# required regardless — loopback leaves it unreachable and compose refuses
# the set. The installer asks which and writes these.
PUBLIC_HOST=
HTTPS_PORT=443
# PUBLIC_ORIGIN=
TLS_DIRECTIVE=
ACME_EMAIL=
# PUBLIC_BIND=0.0.0.0
