# Profile: generic.
#
# Cerea against any OpenAI-compatible third party, with no Pystino anywhere.
# This box holds the chat, its MongoDB, its Postgres (knowledge vectors) and
# the proxy — no gateway, no Valkey, no redaction, no ledger. One shared key
# pays for every call, and the Usage tab stays hidden because there is no
# ledger for it to read.
#
# SAFETY: USE_USER_TOKEN is false here unconditionally. User-token mode would
# send the signed-in person's IdP access token out as a Bearer to the third
# party — a credential leak, not a configuration choice — so the installer
# offers no toggle for it and refuses a file that sets it true.
#
# An env fragment, not a whole deployment: copy it to deploy/.env and fill
# every empty value (the generation command is beside each one), or let the
# installer do both. The overlay set this profile needs is derived by the
# Cerea installer's standalone derivation (base + chat + edge|proxy, started
# by service name so the gateway, Valkey and migrations never start) until
# deploy/profiles/overlays.sh gains the matching profile_overlays entries.
#
# Target footprint: estimate only, not yet weighed on a live host —
# roughly the homelab shape minus the gateway and Valkey (~400 MB RSS,
# ~2.5 GB disk, 1 vCPU).

# --- database ---------------------------------------------------------------
# The chat's own Postgres (knowledge passages and vectors). A separate
# database on this box's instance — there is no gateway database here.
POSTGRES_USER=chat
# Generate locally; the installer does. Empty refuses the first start, which
# is the point: a forgotten password must fail, not default.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=chat

# --- third-party backend ----------------------------------------------------
# Any OpenAI-compatible endpoint. The shared key below pays for every call
# this deployment makes.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Always false on this profile (see the SAFETY note above): the shared key
# pays, and no user token ever leaves this box.
USE_USER_TOKEN=false

# --- chat -------------------------------------------------------------------
# Absolute path to the Cerea checkout — required, never defaulted. A relative
# default resolves against the compose file's directory, which is right for a
# plain checkout and wrong from a git worktree.
CHAT_REPO=
# e.g. CHAT_PG_URL=postgresql://chat:<password>@postgres:5432/chat (role and
# database created by the installer, or by hand — see homelab.env).
CHAT_PG_URL=
# Sign-in still needs a provider — an anonymous deployment answers nobody —
# so all three are mandatory. Register <PUBLIC_ORIGIN>/chat/login/callback
# there exactly.
CHAT_OIDC_PROVIDER_URL=
CHAT_OIDC_CLIENT_ID=
CHAT_OIDC_CLIENT_SECRET=
# CHAT_OIDC_SCOPES=openid profile email
# Encrypts the chat's MCP connector credentials at rest (ADR 0064). Required
# rather than defaulted: a shared default is no encryption that looks like
# encryption.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_SECRET_KEY=
# A plain HTTPS fetch: no renderer service in this profile, and a page built
# by JavaScript arrives as an empty shell — accepted here, because the
# alternative is a 3.45 GB image for an optional fetch backend.
FETCH_BACKEND=direct
# Free: it runs in the signed-in person's own browser sandbox (Pyodide),
# never on this box.
CHAT_CODE_TOOL_ENABLED=true
# Empty on purpose: with no ledger there is nothing for the Usage tab to
# read, so the tab stays hidden.
CHAT_USAGE_ENABLED=false
# Knowledge stays available. Without the two OCR settings below, PDFs and
# Office files cannot be read: attachments go in blind and ingestion is
# text-only.
CHAT_KNOWLEDGE_ENABLED=true
# Empty on purpose: this origin does not serve the Pystino console —
# generic has no Pystino at all. The chat's admin panel shows no console link.
CHAT_CONSOLE_ENABLED=
# Optional: reads PDFs by calling an OCR endpoint directly, since there is no
# gateway here to run /v1/ocr through. Any endpoint serving Mistral's /ocr
# shape works — Mistral's own cloud API, Cortecs, or a self-hosted
# equivalent. Leave both empty to keep documents unread. CHAT_OCR_MODEL is
# required whenever this is set (there is no catalogue to discover a model
# from without a gateway) — the chat refuses to start otherwise. Office
# formats (.docx/.xlsx/.pptx/.odt/.epub) still need a gateway reader; this
# path only reads PDFs.
#   e.g. https://api.mistral.ai/v1
CHAT_OCR_BASE_URL=
CHAT_OCR_API_KEY=
CHAT_OCR_MODEL=

# --- exposure ---------------------------------------------------------------
# Edge or proxy — one of them is required, not optional: the chat publishes
# no port, so without an exposure overlay it is unreachable (and compose
# refuses the set, because the chat depends on the proxy). The installer asks
# which and writes these. PUBLIC_HOST is what a browser *types*.
PUBLIC_HOST=
HTTPS_PORT=443
# PUBLIC_ORIGIN=
TLS_DIRECTIVE="tls internal"
ACME_EMAIL=
# PUBLIC_BIND=0.0.0.0
