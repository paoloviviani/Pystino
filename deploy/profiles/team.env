# Profile: team.
#
# Homelab plus accountability: pattern-only redaction and the local extractor
# (no NER model, no 900 MB sidecar), with the ledger and its quotas switched
# back on. What this adds over homelab is ~300 MB RSS for the two
# model-less service copies.
#
# An env fragment: copy it to deploy/.env and fill every empty value (the
# generation command is beside each one), or let the installer do both. The
# overlay set is derived from deploy/profiles/overlays.sh, the single source
# both the installers and docs/deployment.md read.

# --- database ---------------------------------------------------------------
POSTGRES_USER=gateway
POSTGRES_PASSWORD=
POSTGRES_DB=gateway

# --- gateway ----------------------------------------------------------------
GATEWAY_ENVIRONMENT=production
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_JSON=true

# Encrypts provider API keys at rest (ADR 0027). Comma-separated to rotate.
# Back this up with the database — losing every value means re-entering each
# provider's credential by hand.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SECRET_KEY=

# Signs management session cookies:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_SESSION_SECRET=

# Behind the edge or proxy overlay this must be true (both overlays set it
# themselves); on the loopback default it stays false.
GATEWAY_SESSION_COOKIE_SECURE=false

GATEWAY_BILLING_CURRENCY=EUR

# --- upstream provider ------------------------------------------------------
GATEWAY_UPSTREAM__BASE_URL=https://api.cortecs.ai/v1
GATEWAY_UPSTREAM__API_KEY=

# --- ledger on, quotas on, redaction pattern-only -----------------------------
GATEWAY_ACCOUNTING__ENABLED=true
GATEWAY_QUOTA__ENABLED=true
# Forced to http by the redaction overlay anyway; stated here so dropping the
# overlay fails closed (startup refusal without a placeholder key) rather
# than silently running unredacted.
GATEWAY_REDACTION__ENGINE=http

# Overlay inputs, not gateway settings: with the redaction overlay passed,
# the gateway's key, language and build shape come from these names.
# Deterministic-placeholder HMAC key. It must stay stable for as long as the
# transcripts it labelled are kept: rotating it re-labels every entity, so
# old placeholders stop matching. Back it up with the transcripts.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
REDACTION_PLACEHOLDER_KEY=
REDACTION_LANGUAGE=en
# Pattern-only: an empty build carries no spaCy model, and the disabled engine
# runs the pattern and checksum recognisers in ~150 MB instead of ~900.
# /healthz reports the model-backed entities as absent so the console hides
# them. NER arrives by naming a model here (enterprise) — and accepting its
# licence (CC BY-NC-SA 3.0 for the Italian name model; the default build is
# MIT throughout).
SPACY_MODELS=
REDACTION_NLP_ENGINE=disabled

# Where local document extraction happens: the redaction overlay's second
# deployment of the same image. A provider row's own Base URL wins over this,
# so a deployment can run more than one extractor.
GATEWAY_EXTRACTOR__ENDPOINT=http://extractor:8080

# --- sign-in: local passwords and the house IdP ------------------------------
GATEWAY_LOCAL_AUTH__ENABLED=true
GATEWAY_IDP__ENABLED=true
GATEWAY_IDP__ISSUER=
#   openssl ecparam -genkey -name prime256v1
GATEWAY_IDP__SIGNING_KEY=
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_IDP__INTERNAL_TOKEN=
GATEWAY_IDP__INTERNAL_BASE_URL=http://gateway:8000
GATEWAY_IDP__CLIENTS=[{"client_id":"cerea","redirect_path":"/chat/login/callback","secret":""}]

# --- chat -------------------------------------------------------------------
CHAT_REPO=
CHAT_CATALOGUE_KEY=
# e.g. CHAT_PG_URL=postgresql://chat:<password>@postgres:5432/chat (role and
# database created by the installer, or by hand — see homelab.env).
CHAT_PG_URL=
# Must match the secret in GATEWAY_IDP__CLIENTS above:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_IDP_CLIENT_SECRET=
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_SECRET_KEY=
FETCH_BACKEND=direct
CHAT_CODE_TOOL_ENABLED=true
# On here: the ledger exists, so the Usage tab has quotas and spend to show.
CHAT_USAGE_ENABLED=true
CHAT_KNOWLEDGE_ENABLED=true
# On: this origin serves the Pystino console at /console, and the chat's
# admin panel links to it for the platform side (providers, models, prices,
# quotas, users).
CHAT_CONSOLE_ENABLED=true

# --- exposure ---------------------------------------------------------------
# Edge or proxy — one of them is required (see homelab.env for why loopback
# is not an option with the chat in the set). The installer asks which and
# writes these.
PUBLIC_HOST=
HTTPS_PORT=443
# PUBLIC_ORIGIN=
TLS_DIRECTIVE="tls internal"
ACME_EMAIL=
# PUBLIC_BIND=0.0.0.0
