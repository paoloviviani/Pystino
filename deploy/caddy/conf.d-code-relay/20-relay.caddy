# The paseo-relay, on the origin already published.
# Mounted into conf.d only by docker-compose.code-relay.yml.
#
# `handle /ws*`, not `handle_path /relay/*` — and the difference is forced
# by the client, not chosen: every paseo client (the daemon on the person's
# machine, and Cerea through the SDK) builds its relay URL as
# <scheme>://<host>:<port>/ws via buildRelayWebSocketUrl, which takes a
# host:port endpoint and hardcodes the path. A nested prefix like /relay/ws
# is unreachable — no client can generate it — so the subpath the relay
# lives at is /ws itself. Nothing else in this stack serves /ws (verified:
# no /ws route in the gateway, the chat, or any other overlay), and the
# match is exact-prefix so /wsanything-else never collides: only /ws and
# paths beneath it route here.
#
# No stripping: the relay genuinely serves at /ws (plus /health and /ready
# beside it), so the path arrives intact — the Keycloak strip-prefix shape
# would hand it /ws with nothing stripped anyway, and stating handle keeps
# the file honest about that.
#
# WebSocket upgrade needs no stated config: Caddy detects Upgrade and
# disables buffering for the hijacked connection on its own. The relay is
# identity-blind (ADR 0085) — it bridges sessions and never sees plaintext
# — so there is no auth to check at this layer, deliberately.
handle /ws* {
	reverse_proxy relay:4000
}
