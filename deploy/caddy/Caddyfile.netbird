# The NetBird edge shape: one origin, plain HTTP at the listener, TLS is the
# edge's job.
#
#   cerea.pviviani.eu ──▶ NetBird reverse proxy (TLS, public) ──▶ this box's
#   :8443 ──▶ Caddy here ──▶ gateway:8000 or chat:3000 by path
#
# Four things about the shape, and why:
#
#   * `auto_https disable_redirects`, not `off`: the :8443 site must stay
#     plain (TLS is upstream's), but the second site below needs Caddy to
#     still manage certificates. `off` would disable both; this keeps the
#     certificates and drops only the http→https redirects.
#   * the minting paths are refused here as defence in depth (ADR 0068's
#     network classes: discovery advertises the compose-internal token URL
#     to every standards client, so this file is the second layer, not the
#     first);
#   * /chat reaches the chat WITH its prefix intact. `handle`, not
#     `handle_path`: SvelteKit bakes APP_BASE=/chat into the build, so the
#     server genuinely serves at /chat/..., and stripping the prefix hands
#     it `/`, which it does not have a route for — a flat 404 on the page
#     and no error anywhere explaining why. Measured on the container
#     directly: `/` answers 404 and `/chat/` answers the application.
#   * the second site exists for the box's own services: this box cannot
#     hairpin to its own public name (the edge does not answer its own
#     address from behind the site's NAT), and the *chat's server side*
#     must fetch discovery from the issuer URL, which is that name. The
#     proxy therefore also answers as cerea.pviviani.eu inside the compose
#     network (the network alias in docker-compose.edge.yml), over TLS from
#     its own internal CA — because the issuer URL is https everywhere and
#     a plain answer to an https scheme is a handshake failure, not a
#     fallback. The only client of that listener is the chat, which is
#     handed the CA root (NODE_EXTRA_CA_CERTS in the chat overlay); TLS
#     inside the net is transport here, not trust.
{
	auto_https disable_redirects
}

(origin-routes) {
	@minting path /oauth/token /auth/token /auth/revoke

	# Minting surface, refused at the edge (ADR 0068). 404 rather than 401:
	# a prober learns nothing either way, and the endpoint that does exist
	# answers on the compose network, not here. A `handle`, not a bare
	# `respond` — Caddy sorts directives into routes, and a bare respond
	# with a named matcher landed *after* the catch-all handle, which is a
	# refusal nobody can reach. As the first handle block it is the first
	# thing evaluated, and handle blocks are mutually exclusive.
	handle @minting {
		respond 404
	}

	# The chat, with its prefix intact (see above).
	handle /chat/* {
		reverse_proxy chat:3000 {
			# Chat responses are server-sent events, and Caddy's own flush
			# heuristic is a content-type match. Stating it removes the
			# question — buffering a stream produces no error, just an answer
			# that arrives all at once at the end, which reads as a hung UI.
			flush_interval -1
		}
	}

	# A person typing the bare `/chat` gets a 404 otherwise.
	redir /chat /chat/

	handle {
		reverse_proxy gateway:8000 {
			# `-1` means flush every write straight through instead of
			# buffering. Caddy already does this when it recognises
			# text/event-stream, but every /v1 surface here can stream and
			# the recogniser is a content-type match; stating it removes the
			# question. Buffering a stream produces no error — the bytes are
			# all correct and all late.
			flush_interval -1
		}
	}
}

# The edge's hop: plain HTTP, TLS already handled upstream.
:8443 {
	import origin-routes
}

# The compose-internal answer to the public name. Port 443 because the URLs
# clients hold carry no port; TLS from Caddy's internal CA, whose root the
# chat trusts by mount.
cerea.pviviani.eu {
	tls internal
	import origin-routes
}
