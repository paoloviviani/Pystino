# The bundled Authelia, on the origin already published.
# Mounted into conf.d only by docker-compose.idp-authelia.yml.
#
# `handle`, **not** `handle_path` — the opposite of the Keycloak route, and
# the difference is where the prefix lives:
#
#   Keycloak serves at its own root and is *told* to advertise `/idp`
#   (KC_HOSTNAME), so Caddy strips the prefix before proxying.
#
#   Authelia serves under the prefix itself (`server.address`
#   `tcp://:9091/authelia` in the generated configuration) and advertises
#   every URL with it. Stripping the prefix hands it `/api/oidc/...` paths
#   it does not serve — the portal's assets 404, and the failure names the
#   asset rather than the routing.
#
# Getting this wrong is quiet rather than loud, same as the Keycloak route:
# with `handle_path` the upstream sees unprefixed paths against an Authelia
# rooted at /authelia, every path 404s, and the discovery document — the one
# thing that would explain it — is one of the 404s.
handle /authelia/* {
	reverse_proxy authelia:9091 {
		# The edge hop is plain HTTP, so Caddy's automatic X-Forwarded-Proto
		# would say 'http' — which Authelia rightly refuses ('invalid
		# X-Forwarded-Proto header value'): every URL it advertises is
		# https, and a proxy claiming otherwise is a misconfiguration it
		# refuses to guess around. The edge terminates TLS and forwards
		# https to the listener, so the honest value is fixed here. Under
		# the TLS proxy shape Caddy already sends https and `header_up`
		# setting it again is a no-op — one snippet serves both shapes.
		# (The Keycloak route needs no equivalent: with KC_PROXY_HEADERS
		# the header is read when present, and KC_HOSTNAME fixes the
		# advertised URLs regardless of what the hop says.)
		header_up X-Forwarded-Proto https
	}
}

# Without this, a person typing the bare `/authelia` gets a 404: `/authelia/*`
# matches the prefix *and a slash*, and the path with no trailing slash is
# not that. Same shape as the chat route beside it.
redir /authelia /authelia/
