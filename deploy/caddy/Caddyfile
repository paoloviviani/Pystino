# Pystino's one reverse proxy, gateway-only: there is no chat here, so `/` is
# always the gateway (API and console). Three TLS modes, one file, chosen by
# the environment (deploy/.env.example writes all three variables):
#
#   acme       SITE_ADDRESS=https://llm.example.org   TLS_DIRECTIVE=
#   internal   SITE_ADDRESS=https://10.0.0.5          TLS_DIRECTIVE="tls internal"   (dev only)
#   upstream   SITE_ADDRESS=http://:80                TLS_DIRECTIVE=                 (TLS ends in front, e.g. NetBird)
#
# The routes are identical in every mode. /authelia answers 502 with the
# profile off; Caddy resolves upstreams per request, so a missing service
# never stops the proxy starting.
#
# No server ever calls the public origin: the gateway reaches the bundled
# Authelia on the compose network (GATEWAY_OIDC__INTERNAL_BASE_URL), so
# Caddy's internal CA is never something a container has to trust.
#
# The full stack, with the chat, is the separate `cerea-deploy` repository
# (private for now); its Caddyfile is this one plus the /chat routes.
{
	email {$ACME_EMAIL:admin@example.org}
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

(to_app) {
	# The public origin is https in all three modes; in upstream mode the hop
	# into Caddy is plain HTTP, so the scheme is stated rather than inferred.
	header_up X-Forwarded-Proto https
	flush_interval -1
}

{$SITE_ADDRESS} {
	{$TLS_DIRECTIVE}

	# Operator and component hook: *.caddy snippets dropped into proxy.d/
	# (mounted here) are imported inside the site block. None is needed by
	# default; a glob that matches nothing is not an error.
	import /etc/caddy.d/*.caddy

	handle /authelia/* {
		reverse_proxy authelia:9091 {
			import to_app
		}
	}
	redir /authelia /authelia/

	# Everything else — `/` included — goes to the gateway: this deployment
	# runs nothing else.
	import /etc/caddy/modes/gateway.caddy
}
