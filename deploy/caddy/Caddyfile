# The reverse proxy in front of the stack, in either of two configurations.
#
# Both are the same file. What differs is what deploy/.env sets, and the two
# shapes are described there in full:
#
#   dev   PUBLIC_HOST=130.192.84.103  HTTPS_PORT=8443  TLS_DIRECTIVE="tls internal"
#         An IP address and Caddy's own CA. The browser warns once, because
#         nothing has heard of that CA — which is what a self-signed certificate
#         is, however it was produced.
#
#   prod  PUBLIC_HOST=llm.example.org HTTPS_PORT=443   TLS_DIRECTIVE=
#         A name, and an empty directive so Caddy's automatic HTTPS takes over:
#         it obtains and renews a Let's Encrypt certificate on its own. That
#         needs the name to resolve to this host and ports 80 and 443 reachable
#         from the internet, because the challenge arrives on one of them.
#
# Let's Encrypt will not issue for an IP address and Caddy's internal CA is
# trusted by nothing, so the two are not interchangeable: which one you get is
# decided by whether you have a name, and the variables say so out loud rather
# than it being inferred from the shape of the host.
#
# ## One origin, one router
#
# The obvious arrangement is two ports — the gateway on one, an identity
# provider on another — because the gateway owns /auth/callback and an IdP owns
# its own paths, and those collide at the root. One origin is what makes the
# session cookie trivially same-origin and the deployment one thing to publish.
# The IdP is therefore *not* part of this stack at all: OIDC is configured
# against whatever provider deploy/.env names (docs/oidc-generic-provider.md),
# on its own host, and this file routes only to what lives here.
#
# They collide at the *root*. Under a prefix they do not, which is the opening
# `docker-compose.keycloak.yml` takes: a development Keycloak on `/idp`, still
# one origin and still one published port. That overlay drops a file into
# conf.d below; nothing else routes there, so a deployment that does not use it
# is byte-for-byte unchanged.
#
# The glob is why conf.d/00-empty.caddy is committed: Caddy treats an `import`
# that matches no files as an error, so the placeholder is what keeps the base
# configuration valid on its own.

{
	# Only used in prod, where Caddy needs somewhere to send expiry warnings.
	# Ignored entirely by `tls internal`.
	email {$ACME_EMAIL:admin@example.org}

	# Without this the IP configuration fails every handshake with a TLS
	# "internal error" alert, and logs nothing above debug level.
	#
	# SNI may not carry a literal IP address (RFC 6066), so no client sends one
	# for https://130.192.84.103 — and Caddy, given no server name, falls back to
	# matching the connection's *local* address against the certificates it
	# holds. Behind Docker's NAT that address is the container's 172.x, which
	# matches nothing, so it has no certificate to offer. Naming the default
	# explicitly is what makes an address-only deployment serve at all.
	default_sni {$PUBLIC_HOST}
}

{$PUBLIC_ORIGIN} {
	{$TLS_DIRECTIVE}

	# Opt-in extra routes, before the catch-all below. Only the committed
	# placeholder matches unless an overlay mounts something here.
	import /etc/caddy/conf.d/*.caddy

	handle {
		# `-1` means flush every write straight through instead of buffering.
		# Caddy already does this when it recognises text/event-stream, but every
		# /v1 surface here can stream and the recogniser is a content-type match;
		# stating it removes the question. Buffering a stream produces no error —
		# the bytes are all correct and all late.
		reverse_proxy gateway:8000 {
			flush_interval -1
		}
	}
}
