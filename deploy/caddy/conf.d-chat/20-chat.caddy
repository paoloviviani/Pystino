# The chat application, on the origin already published.
# Mounted into conf.d only by docker-compose.chat.yml.
#
# `handle`, **not** `handle_path` — the opposite of the Keycloak route beside
# it, and the difference is worth stating because both look like "serve this
# under a prefix".
#
#   Keycloak serves at its own root and is *told* to advertise `/idp`
#   (KC_HOSTNAME), so Caddy strips the prefix before proxying.
#
#   SvelteKit does the reverse: `APP_BASE=/chat` is baked into the build, so
#   the server genuinely *serves* at `/chat/...`. Stripping the prefix hands it
#   `/`, which it does not have a route for — a flat 404 on the page and no
#   error anywhere explaining why. Measured on the container directly: `/`
#   answers 404 and `/chat/` answers the application.
handle /chat/* {
	reverse_proxy chat:3000 {
		# Chat responses are server-sent events, and Caddy's own flush
		# heuristic is a content-type match. Stating it removes the question —
		# buffering a stream produces no error, just an answer that arrives
		# all at once at the end, which reads as a hung UI.
		flush_interval -1
	}
}

# Without this, a person typing the bare `/chat` gets a 404: `/chat/*` matches
# the prefix *and a slash*, and the path with no trailing slash is not that.
redir /chat /chat/
