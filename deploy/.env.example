# Copy to deploy/.env and edit. Never commit deploy/.env — it is gitignored.
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/compose/docker-compose.yml up

# --- database ---------------------------------------------------------------
POSTGRES_USER=gateway
POSTGRES_PASSWORD=change-me-before-anything-else
POSTGRES_DB=gateway

# --- gateway ----------------------------------------------------------------
# GATEWAY_PORT is compose-level, not a gateway setting: it is the loopback
# port the base file publishes the gateway on.
GATEWAY_PORT=8000
GATEWAY_ENVIRONMENT=dev
GATEWAY_LOG_LEVEL=INFO
GATEWAY_LOG_JSON=true

# Signs management session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Encrypts provider API keys at rest (ADR 0027). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Comma-separated to rotate: the first value encrypts, any of them decrypts.
# Back this up with the database — losing every value means re-entering each
# provider's credential by hand.
GATEWAY_SECRET_KEY=

GATEWAY_SESSION_SECRET=

# Set to true behind TLS. Left false for local http, or the cookie is dropped.
GATEWAY_SESSION_COOKIE_SECURE=false

# All prices and quotas are denominated in this currency. A model priced in
# anything else is refused rather than converted, because a silent exchange rate
# produces invoices that look correct and are not.
GATEWAY_BILLING_CURRENCY=EUR

# --- upstream provider ------------------------------------------------------
# Any OpenAI-compatible endpoint. Cortecs is the default because it bills in EUR
# and is EU-hosted; anything speaking the same API works.
#
# Nested gateway settings use a double underscore (GATEWAY_UPSTREAM__BASE_URL):
# that is the delimiter config.py reads, and a single underscore is silently
# ignored. The compose files interpolate these same names, so what is written
# here is what the gateway receives — there is no second spelling.
GATEWAY_UPSTREAM__BASE_URL=https://api.cortecs.ai/v1
GATEWAY_UPSTREAM__API_KEY=

# --- document extraction ----------------------------------------------------
# The local backend of `/v1/ocr`: Word, Excel, PowerPoint and text-layer PDFs,
# read inside the deployment so nothing leaves it. Scanned pages are refused
# rather than guessed at — reading those needs an OCR model, which is the same
# surface with a different model behind it.
#
# Only needed with deploy/compose/docker-compose.redaction.yml, which deploys
# the extractor as a second instance of the detection image with its NLP engine
# switched off. A provider row's own Base URL wins over this, so a deployment
# can run more than one extractor.
GATEWAY_EXTRACTOR__ENDPOINT=http://extractor:8080

# --- redaction --------------------------------------------------------------
# Without the redaction overlay these two are the whole configuration.
# `noop` is refused for now rather than silently downgraded, so nobody can
# believe redaction is on when it is not.
GATEWAY_REDACTION__ENGINE=noop

# Keyed HMAC secret for deterministic placeholders. Required once the engine is
# not `noop`. It must stay stable for as long as the transcripts it labelled are
# kept: rotating it re-labels every entity, so old placeholders stop matching.
# Back it up with the transcripts, not just with the database.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_REDACTION__PLACEHOLDER_KEY=
#
# With deploy/compose/docker-compose.redaction.yml passed, the overlay takes
# over the gateway side: it forces ENGINE=http and reads the key from
# REDACTION_PLACEHOLDER_KEY below — no GATEWAY_ prefix, because that name is an
# overlay input, not a gateway setting — the language from REDACTION_LANGUAGE,
# and the build shape from SPACY_MODELS plus REDACTION_NLP_ENGINE. See
# docs/deployment.md ("Redaction: three build shapes") for the three shapes.
# REDACTION_PLACEHOLDER_KEY=
# REDACTION_LANGUAGE=en
# SPACY_MODELS=en_core_web_lg
# REDACTION_NLP_ENGINE=spacy

# --- accounting and quotas (ADR 0065) -----------------------------------------
# Whether this deployment keeps a ledger at all. Both default to on; the
# passthrough shape — routing, keys, model access and redaction with no
# interest in what anything cost — is both off together:
#
#   GATEWAY_ACCOUNTING__ENABLED=false
#   GATEWAY_QUOTA__ENABLED=false
#
# Off means *no row*, never a row of zeros: a zero-cost row cannot be told
# apart from one where the arithmetic failed, so with accounting off the
# gateway writes no `usage_records` at all and the report says metering is off
# rather than showing an empty table that reads as an idle week.
#
# The reverse combination is refused at startup, not warned about: quota
# counters rebuild from `usage_records`, so with no ledger every counter comes
# back at zero and every ceiling silently passes — quotas an administrator
# believes in and no limit that can ever fire. Metering without quotas is
# fine (a ledger with no ceilings is just reporting); quotas without metering
# is incoherent.
GATEWAY_ACCOUNTING__ENABLED=true
GATEWAY_QUOTA__ENABLED=true

# --- OIDC (any OpenID Connect provider) -------------------------------------
# /v1 traffic always uses API keys; OIDC is for humans signing in to manage keys
# and see their spend. With local auth on (see below) this is optional: leave it
# unset and the console's password form is the only way in.
#
# There is no bundled identity provider — docs/oidc-generic-provider.md has a
# worked example for GitLab and the checklist any provider needs.
GATEWAY_OIDC__ENABLED=false
GATEWAY_OIDC__ISSUER=https://gitlab.com
GATEWAY_OIDC__CLIENT_ID=
GATEWAY_OIDC__CLIENT_SECRET=
# The redirect URI is <PUBLIC_ORIGIN>/auth/callback behind the proxy overlay;
# register exactly that on the provider, never a wildcard.
# GATEWAY_OIDC__REDIRECT_URI=

# Which claim carries group membership. Every IdP differs:
#   GitLab     groups_direct          (groups is the legacy claim)
#   Entra ID   groups
#   Keycloak   realm_access.roles
#   namespaced https://example\.org/groups   (escape dots that are not nesting)
GATEWAY_OIDC__GROUPS_CLAIM=groups_direct

# There is no admin-group setting (ADR 0069): authorisation is a gateway fact.
# An administrator is made in the console or with `gateway passwd --admin`,
# and GATEWAY_OIDC__ADMIN_GROUPS — removed, not deprecated — refuses the
# startup if it is still set.

# --- the house IdP (ADR 0068) -------------------------------------------------
# The gateway as a minimal identity provider for its own browser-facing
# clients (the chat): discovery, authorization-code + PKCE, an ES256
# id_token, JWKS, userinfo, end_session. Off means the routes do not exist.
# docs/idp.md carries the whole story, including where each endpoint is
# reachable from.
#
#   GATEWAY_IDP__ENABLED=true
#   GATEWAY_IDP__ISSUER=https://cerea.pviviani.eu
#   # The ES256 key, by path — a PEM is several lines and this file is
#   # line-oriented, so the key lives beside it rather than in it:
#   #   openssl ecparam -genkey -name prime256v1 -out deploy/idp-signing-key.pem
#   #   chmod 600 deploy/idp-signing-key.pem
#   IDP_SIGNING_KEY_HOST_PATH=/absolute/path/to/deploy/idp-signing-key.pem
#   GATEWAY_IDP__SIGNING_KEY_FILE=/run/idp/signing-key.pem
#   # (or inline instead, which still works and is refused if both are set:
#   #  GATEWAY_IDP__SIGNING_KEY=$(openssl ecparam -genkey -name prime256v1 | cat))
#   GATEWAY_IDP__INTERNAL_TOKEN=<long random value>
#   GATEWAY_IDP__INTERNAL_BASE_URL=http://gateway:8000
#   GATEWAY_IDP__CLIENTS=[{"client_id":"cerea","redirect_path":"/chat/login/callback","secret":"..."}]
GATEWAY_IDP__ENABLED=false

# --- local email + password sign-in (ADR 0043) -------------------------------
# The console always offers this when enabled, whatever the identity provider
# situation. The password is never set through the environment — create the
# account out-of-band (it prompts, so nothing lands in shell history):
#
#   docker compose ... exec gateway gateway passwd admin@local
#
GATEWAY_LOCAL_AUTH__ENABLED=false

# The live scripts sign in with these (scripts/live_session.py reads them).
# They are script credentials, not gateway settings — the gateway never reads
# them; the passwords are set out-of-band with `gateway passwd`. Set the
# admin's to the password you gave `gateway passwd`; a second, non-admin
# account powers the 403 checks.
GATEWAY_LOCAL_ADMIN_EMAIL=admin@local
GATEWAY_LOCAL_ADMIN_PASSWORD=
GATEWAY_LOCAL_USER_EMAIL=
GATEWAY_LOCAL_USER_PASSWORD=

# --- reaching the stack from another machine --------------------------------
# The default shape publishes nothing but loopback. From another machine,
# forward one port over SSH (docs/deployment.md has the command) rather than
# publishing the stack: the session cookie is scoped to the origin the login
# happened on, so the local port must match the remote one.

# --- serving the stack on a real address, behind TLS ------------------------
# Only needed with deploy/compose/docker-compose.proxy.yml, which puts Caddy in
# front and terminates TLS. Two supported configurations; pick one.
#
# 1. Development, on an IP address, with a self-signed certificate. Caddy issues
#    it from its own CA, so a browser warns once and nothing else has heard of
#    the issuer. Let's Encrypt will not issue for an IP address, so this is the
#    only option without a name.
#
#      PUBLIC_HOST=130.192.84.103
#      HTTPS_PORT=8443
#      TLS_DIRECTIVE="tls internal"
#
# 2. Production, on a name, with Let's Encrypt. An empty TLS_DIRECTIVE hands the
#    site to Caddy's automatic HTTPS, which obtains and renews the certificate on
#    its own. The name must resolve to this host, and ports 80 and 443 must be
#    reachable from the internet, because that is where the challenge arrives.
#
#      PUBLIC_HOST=llm.example.org
#      HTTPS_PORT=443
#      PUBLIC_ORIGIN=https://llm.example.org
#      TLS_DIRECTIVE=
#      ACME_EMAIL=platform@example.org
#
# PUBLIC_HOST is what a browser *types*; it is not necessarily an address this
# host holds. On a NAT-ed cloud instance it is the floating address while the
# interface has a private one — so what Docker binds is a separate variable,
# PUBLIC_BIND, which defaults to every interface.
#
# PUBLIC_ORIGIN is every advertised URL this deployment builds: the OIDC
# redirect above. It defaults to https://$PUBLIC_HOST:$HTTPS_PORT, which is
# correct but writes ":443" into URLs that do not need it — hence the explicit
# value in the production example.
PUBLIC_HOST=
HTTPS_PORT=443
# PUBLIC_ORIGIN=
# Quoted because it contains a space and the live scripts read this file with
# `set -a; . deploy/.env`, where an unquoted value is a command to run.
TLS_DIRECTIVE="tls internal"
ACME_EMAIL=
# PUBLIC_BIND=0.0.0.0

# --- chat -------------------------------------------------------------------
# Only needed with deploy/compose/docker-compose.chat.yml. The chat is a
# client of the gateway (Cerea, a sibling checkout): it is built from its own
# repository, talks over /v1, and keeps its own stores. Nothing below mounts
# gateway source or reads its environment — only URLs and credentials.
#
# Absolute path to the chat checkout, required rather than defaulted: a
# relative default resolves against the compose file's directory, which is
# right for a plain checkout and wrong from a git worktree.
CHAT_REPO=
# No catalogue key: the chat's boot-time model list reads the gateway's
# public GET /v1/models (ADR 0081), so nothing is minted for it. Only
# OPENAI_API_KEY, set on the chat's own side and unset here, would carry one —
# see Cerea/.env for why that stays unset against Pystino.
# The chat's own Postgres database on the gateway's instance — a second
# database, not a second container — where the knowledge pipeline's passages
# and vectors live (ADR 0070). With the chat's own credentials: neither
# component can read the other's.
#   e.g. CHAT_PG_URL=postgresql://chat:<password>@postgres:5432/chat
CHAT_PG_URL=
# The chat's own client on the house IdP (ADR 0068), distinct from any other —
# two services that authenticate people are two clients, each revocable on its
# own. Must appear in GATEWAY_IDP__CLIENTS with redirect_path
# /chat/login/callback, with a matching secret. The issuer both sides agree
# on is PUBLIC_ORIGIN below.
CHAT_IDP_CLIENT_SECRET=
# Encrypts the chat's MCP connector credentials at rest (ADR 0064). Required
# rather than defaulted: a default would mean every deployment that forgot
# shared a key. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAT_SECRET_KEY=
# Display name baked into the chat image at build time.
# CHAT_APP_NAME=Cerea
# What reads a pasted URL: direct (plain HTTPS, the default) or playwright
# (the headless-browser overlay, which publishes no port).
# FETCH_BACKEND=direct

# --- coding agents (/code panel + relay) -------------------------------------
# Only with deploy/compose/docker-compose.code-relay.yml. The /code panel is
# the chat's remote-agent surface (ADR 0085); the relay is the rendezvous the
# daemons on people's machines dial outbound. Off unless "true": the panel
# hides and its routes answer 404, rather than rendering a surface with no
# relay behind it.
# CODE_AGENTS_ENABLED=
# The relay endpoint Cerea dials per paired device, host:port. Inside the
# compose network the relay service answers at relay:4000; the daemons
# outside reach it at <PUBLIC_HOST>:<RELAY_PORT>.
# CODE_RELAY_URL=relay:4000
# The published port the daemons dial. Changing it changes what daemons
# outside must be able to reach; the compose network side stays 4000.
# RELAY_PORT=4000
