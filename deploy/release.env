# The compatibility manifest: which images one Pystino release is tested with.
#
# `deploy/compose.yaml`'s own defaults name PYSTINO_REGISTRY, PYSTINO_VERSION,
# POSTGRES_IMAGE and VALKEY_IMAGE directly; a unit test fails if a release
# changes this file's PYSTINO_VERSION without changing that default (ADR
# 0091). `pystino release-pin` still pins this manifest's images by digest.
# The rest of it — CEREA_VERSION, MONGO_IMAGE, PLAYWRIGHT_IMAGE — is what
# `cerea-deploy` pins its own compose.yaml to: a Pystino release names one
# tested pair (Pystino + Cerea) plus the exact upstream images (ADR 0087,
# ADR 0091 decision 2).
#
# The upstream images below carry `@sha256:…` digests, written by
# `pystino release-pin` (re-run it to move them; the images workflow's
# `release-pins` job runs `--check` on release tags and fails on a bare tag).
# CEREA_IMAGE is derived from CEREA_VERSION and pinned the same way once
# that Cerea image is published.
PYSTINO_REGISTRY=ghcr.io/paoloviviani
PYSTINO_VERSION=0.2.4
CEREA_REGISTRY=ghcr.io/paoloviviani
# galopin, the Cerea machine agent, ships from the chat repository's agent/ at
# this same Cerea revision: there is no separate agent pin, and the dist for
# agent machines is built from the pinned Cerea tree.
CEREA_VERSION=0.3.3
POSTGRES_IMAGE=pgvector/pgvector:pg18@sha256:2358fcba361ed2233a5ed81b5fe4ca779ccb304120ce531a3bf51c0ed7e2bc11
VALKEY_IMAGE=valkey/valkey:8-alpine@sha256:081c2f5cb575efc901aa80ff9cdbd1ec6a301682fd35e1ebb4b0990a4a4a8507
MONGO_IMAGE=mongo:4.4@sha256:4be76f674fc4b27859816811b8baa3c51830eb1dbf4ca81a51e26b79edd662ef
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.61.1-noble@sha256:5b8f294aff9041b7191c34a4bab3ac270157a28774d4b0660e9743297b697e48
PLAYWRIGHT_VERSION=1.61.1
CEREA_IMAGE=ghcr.io/paoloviviani/cerea:0.3.3@sha256:836c8fc611b62c1ea2ab9b4cddb33cbb1fa0c712c7b42afc5273b5cd847bd7cc
