# The bundled-Keycloak route, on the origin already published.
# Generated by the installer to deploy/idp/10-idp-keycloak.caddy (copied
# verbatim — no placeholders: the block is origin-independent) and mounted
# into conf.d by docker-compose.idp-keycloak.yml.
#
# `handle_path`, not `handle`: it strips the matched prefix before proxying,
# so Keycloak keeps serving at the root it believes it is at while every URL
# it *advertises* carries /idp, because KC_HOSTNAME says so. The prefix is
# therefore applied exactly once, here, in the layer that owns routing — which
# is why KC_HTTP_RELATIVE_PATH is deliberately not set.
#
# Getting this wrong is quiet rather than loud: with `handle` the upstream
# sees /idp/realms/... against a Keycloak rooted at /, every path 404s, and
# the discovery document — the one thing that would explain it — is one of
# the 404s.
#
# Edge exposure (Caddyfile.netbird) has no conf.d import, so the installer
# appends this same block to both sites there instead of mounting this file.
handle_path /idp/* {
	reverse_proxy keycloak:8080 {
		# Keycloak builds absolute URLs from what it thinks the client asked
		# for, and KC_PROXY_HEADERS=xforwarded is what makes it read these
		# rather than the container's own address.
		header_up X-Forwarded-Prefix /idp
	}
}
