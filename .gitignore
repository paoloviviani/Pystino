.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
site/
dist/
build/
*.egg-info/

# A hand-maintained copy of the built console. Nothing reads it: the image
# bakes `apps/console/dist` at build time, and the dev overlay serves that
# same directory through GATEWAY_CONSOLE_DIR. A copy here is served by
# nothing and confuses every future reconcile — and its mere presence used
# to flip a console-sensitive test by mounting the console in it.
apps/gateway/src/gateway/console_static/

node_modules/
.next/
out/

# Secrets: only *.env.example is tracked.
#
# `*.env` is deliberately broad. The narrower `.env` / `.env.*` pair does NOT
# match a file like `.gitlab.env`, which is exactly the kind of credential file
# that ends up in a repository root and gets committed by accident.
*.env
.env
.env.*
!*.env.example
!.env.example
# The deployment profile fragments are env-shaped but not secrets: every
# credential field in them is an empty template the installer fills, and a
# fresh clone must carry them or the Cerea installer's checkout validation
# refuses the very repository it just cloned ("missing
# deploy/profiles/homelab.env — wrong repository?"). Untracked, they
# survived only in working copies that predated this ignore rule.
!deploy/profiles/*.env
deploy/.env

*.db
*.sqlite3

# Local screenshots from manual UI checks.
.console-shots/

# Credential files that are not *.env — the pattern above does not catch them.
# Both spellings named explicitly because the file has gone by each; the glob
# also covers a renamed or backup copy (`.bak`, a date), equally secret.
.gitlab-token
.gitlab-tokens
.gitlab-token*
.gh-token
.gh-token*

# Local agent-tooling state, not project config.
paseo.json

# Self-signed material and Caddy state, if either is ever written outside a volume.
deploy/tls/*
# The internal CA's *root certificate* is public material — clients trust by
# mount — so it is tracked; the private material never lands in this
directory.
!deploy/tls/caddy-root.crt

# The pnpm store, left behind when the JS toolchain is run in a container
# (there is no node on the deployment host). Not a build output — a cache.
.pnpm-store/

# The paseo-relay source deploy/code-relay/fetch.sh checks out — a pinned
# vendored tree, fetched at install time, never ours to edit.
deploy/code-relay/paseo-relay/
